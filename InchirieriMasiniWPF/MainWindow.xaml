<Window x:Class="InchirieriMasiniWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InchirieriMasiniWPF"
        xmlns:conv="clr-namespace:InchirieriMasiniWPF.Convertoare"
        xmlns:enums="clr-namespace:LibrarieModele;assembly=LibrarieModele"
        Title="AutoRent — Sistem Inchirieri Masini"
        MinWidth="1100" MinHeight="700"
        Width="1320" Height="820"
        Background="{StaticResource BrushBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontText}">

    <Window.Resources>
        <conv:EnumToBooleanConverter      x:Key="enumToBool"/>
        <conv:CuloareMasinaToBrushConverter x:Key="culoareToBrush"/>
        <conv:BoolToVisibilityConverter   x:Key="boolToVis"/>
    </Window.Resources>

    <!-- Grid principal: sidebar fix (260px) + continut elastic -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!--  SIDEBAR                                       -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushNavBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO + BRAND -->
                <Grid Grid.Row="0" Margin="22,24,22,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo mark: cerc cu gradient + car glyph -->
                    <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0">
                        <Ellipse Fill="{StaticResource BrushAccentGradient}"/>
                        <TextBlock Text="&#xE7C0;" FontFamily="{StaticResource FontIcons}"
                                   FontSize="20" Foreground="#0B1220"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AutoRent" FontFamily="{StaticResource FontDisplay}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sistem inchirieri" FontSize="11"
                                   Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- NAV LABEL -->
                <TextBlock Grid.Row="1" Text="MENIU" Margin="24,0,24,10"
                           FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>

                <!-- NAV ITEMS -->
                <StackPanel Grid.Row="2" Margin="14,0,14,0">
                    <Button x:Name="btnMeniuMasini" Style="{StaticResource BtnNav}" Click="MeniuMasini_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7C0;" FontFamily="{StaticResource FontIcons}"
                                       FontSize="16" Margin="6,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Administrare masini" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1F2937" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                <TextBlock FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"
                                           Text="{Binding ElementName=dgMasini, Path=Items.Count}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="btnMeniuRezervari" Style="{StaticResource BtnNav}" Click="MeniuRezervari_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="{StaticResource FontIcons}"
                                       FontSize="16" Margin="6,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Rezervari" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1F2937" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                <TextBlock FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"
                                           Text="{Binding ElementName=dgRezervari, Path=Items.Count}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="btnMeniuCautare" Style="{StaticResource BtnNav}" Click="MeniuCautare_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource FontIcons}"
                                       FontSize="16" Margin="6,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Cauta masina" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Border Background="#1E293B" Height="1" Margin="6,18,6,16"/>

                    <TextBlock Text="INFO" Margin="10,0,10,8"
                               FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>

                    <Border Background="#111B2D" CornerRadius="10" Padding="14" Margin="6,0,6,8">
                        <StackPanel>
                            <TextBlock Text="Disponibile acum" FontSize="11" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tbStatsDisponibile" Foreground="White"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="22"
                                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#111B2D" CornerRadius="10" Padding="14" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Venit estimat" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="tbStatsVenit" Foreground="White"
                                       FontFamily="{StaticResource FontDisplay}" FontSize="22"
                                       FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="din rezervari active" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FOOTER -->
                <Border Grid.Row="3" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="© PIU — ICE USV" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="Proiect academic" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!--  ZONA CONTINUT                                 -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">

            <!-- ////////////  PANEL: ADMINISTRARE MASINI  //////////// -->
            <ScrollViewer x:Name="panelMasini" VerticalScrollBarVisibility="Auto" Padding="0">
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HERO -->
                    <Border Grid.Row="0" CornerRadius="18" Padding="32,28"
                            Background="{StaticResource BrushHero}" Effect="{StaticResource ShadowMedium}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#1E293B" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Administrare flota" Margin="6,0,0,0"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Gestionare masini" Margin="0,14,0,6"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="32"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Adauga, editeaza si controleaza disponibilitatea masinilor din flota."
                                           FontSize="13" Foreground="#94A3B8" MaxWidth="540" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Ilustratie masina (Path-based) -->
                            <Viewbox Grid.Column="1" Width="240" Height="120" Margin="20,0,0,0">
                                <Canvas Width="200" Height="100">
                                    <!-- background glow -->
                                    <Ellipse Canvas.Left="20" Canvas.Top="60" Width="160" Height="20"
                                             Fill="#F59E0B" Opacity="0.18"/>
                                    <!-- caroserie -->
                                    <Path Fill="#F8FAFC"
                                          Data="M 10,55 L 28,55 L 50,22 L 130,22 L 158,55 L 184,55
                                                Q 194,55 194,64 L 194,76 L 178,76
                                                A 14,14 0 1 0 142,76 L 60,76
                                                A 14,14 0 1 0 24,76 L 10,76
                                                Q 0,76 0,68 L 0,62 Q 0,55 10,55 Z"/>
                                    <!-- geam -->
                                    <Path Fill="#0B1220" Opacity="0.85"
                                          Data="M 60,30 L 124,30 L 142,52 L 50,52 Z"/>
                                    <Path Fill="#1E293B"
                                          Data="M 92,30 L 92,52 M 90,30 L 94,30 L 94,52 L 90,52 Z"/>
                                    <!-- linie cromata -->
                                    <Rectangle Canvas.Left="40" Canvas.Top="55" Width="120" Height="2" Fill="#F59E0B" Opacity="0.6"/>
                                    <!-- roti -->
                                    <Ellipse Canvas.Left="146" Canvas.Top="62" Width="32" Height="32" Fill="#0B1220"/>
                                    <Ellipse Canvas.Left="152" Canvas.Top="68" Width="20" Height="20" Fill="#475569"/>
                                    <Ellipse Canvas.Left="156" Canvas.Top="72" Width="12" Height="12" Fill="#94A3B8"/>
                                    <Ellipse Canvas.Left="28" Canvas.Top="62" Width="32" Height="32" Fill="#0B1220"/>
                                    <Ellipse Canvas.Left="34" Canvas.Top="68" Width="20" Height="20" Fill="#475569"/>
                                    <Ellipse Canvas.Left="38" Canvas.Top="72" Width="12" Height="12" Fill="#94A3B8"/>
                                    <!-- far -->
                                    <Ellipse Canvas.Left="180" Canvas.Top="58" Width="10" Height="6" Fill="#FBBF24"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- STATS CARDS -->
                    <Grid Grid.Row="1" Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total masini" Style="{StaticResource TextMuted}" FontSize="12"/>
                                    <TextBlock Text="{Binding ElementName=dgMasini, Path=Items.Count}"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="34"
                                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BrushInfoSoft}"
                                        CornerRadius="10" Width="48" Height="48" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7C0;" FontFamily="{StaticResource FontIcons}" FontSize="22"
                                               Foreground="{StaticResource BrushInfo}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disponibile" Style="{StaticResource TextMuted}" FontSize="12"/>
                                    <TextBlock x:Name="tbStatDisponibile" Text="0"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="34"
                                               FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BrushSuccessSoft}"
                                        CornerRadius="10" Width="48" Height="48" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FontIcons}" FontSize="20"
                                               Foreground="{StaticResource BrushSuccess}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="In rezervare" Style="{StaticResource TextMuted}" FontSize="12"/>
                                    <TextBlock x:Name="tbStatRezervate" Text="0"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="34"
                                               FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BrushAccentSoft}"
                                        CornerRadius="10" Width="48" Height="48" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource FontIcons}" FontSize="20"
                                               Foreground="{StaticResource BrushAccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- FORM + PREVIEW (2 columns) -->
                    <Grid Grid.Row="2" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- FORM CARD -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Detalii masina" Style="{StaticResource TextH3}" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="MARCA"/>
                                        <TextBox x:Name="txtMarca" MaxLength="20"
                                                 Text="{Binding MasinaCurenta.Marca, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnDataErrors=True}"/>
                                        <TextBlock Foreground="{StaticResource BrushDanger}" FontSize="11" Margin="2,4,0,0"
                                                   Text="{Binding ElementName=txtMarca, Path=(Validation.Errors)/ErrorContent}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="MODEL"/>
                                        <TextBox x:Name="txtModel" MaxLength="25"
                                                 Text="{Binding MasinaCurenta.Model, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnDataErrors=True}"/>
                                        <TextBlock Foreground="{StaticResource BrushDanger}" FontSize="11" Margin="2,4,0,0"
                                                   Text="{Binding ElementName=txtModel, Path=(Validation.Errors)/ErrorContent}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="PRET / ZI (LEI)"/>
                                        <TextBox x:Name="txtPret"
                                                 Text="{Binding MasinaCurenta.PretPeZi, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnDataErrors=True,
                                                                StringFormat=N2}"/>
                                        <TextBlock Foreground="{StaticResource BrushDanger}" FontSize="11" Margin="2,4,0,0"
                                                   Text="{Binding ElementName=txtPret, Path=(Validation.Errors)/ErrorContent}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="CULOARE"/>
                                        <ComboBox x:Name="cmbCuloare"
                                                  SelectedItem="{Binding MasinaCurenta.Culoare, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="DATA ADAUGARE"/>
                                        <DatePicker x:Name="dtpDataAdaugare"
                                                    SelectedDate="{Binding MasinaCurenta.DataAdaugare, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TextLabel}" Text="STATUS" Margin="0"/>
                                                <TextBlock Text="Marcheaza ca disponibila" FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      IsChecked="{Binding MasinaCurenta.Disponibila, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Combustibil + Optiuni -->
                                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10"
                                        Padding="14,12" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TextLabel}" Text="COMBUSTIBIL"/>
                                        <WrapPanel>
                                            <RadioButton Content="Benzina"  GroupName="Combustibil"
                                                         IsChecked="{Binding MasinaCurenta.Combustibil, Mode=TwoWay,
                                                                     Converter={StaticResource enumToBool},
                                                                     ConverterParameter={x:Static enums:TipCombustibil.Benzina}}"/>
                                            <RadioButton Content="Motorina" GroupName="Combustibil"
                                                         IsChecked="{Binding MasinaCurenta.Combustibil, Mode=TwoWay,
                                                                     Converter={StaticResource enumToBool},
                                                                     ConverterParameter={x:Static enums:TipCombustibil.Motorina}}"/>
                                            <RadioButton Content="Hibrid"   GroupName="Combustibil"
                                                         IsChecked="{Binding MasinaCurenta.Combustibil, Mode=TwoWay,
                                                                     Converter={StaticResource enumToBool},
                                                                     ConverterParameter={x:Static enums:TipCombustibil.Hibrid}}"/>
                                            <RadioButton Content="Electric" GroupName="Combustibil"
                                                         IsChecked="{Binding MasinaCurenta.Combustibil, Mode=TwoWay,
                                                                     Converter={StaticResource enumToBool},
                                                                     ConverterParameter={x:Static enums:TipCombustibil.Electric}}"/>
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource TextLabel}" Text="OPTIUNI" Margin="0,14,0,6"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="cbAer"     Content="Aer conditionat" Margin="0,0,18,4"
                                                      Checked="Optiuni_Schimbat" Unchecked="Optiuni_Schimbat"/>
                                            <CheckBox x:Name="cbNav"     Content="Navigatie"        Margin="0,0,18,4"
                                                      Checked="Optiuni_Schimbat" Unchecked="Optiuni_Schimbat"/>
                                            <CheckBox x:Name="cbAuto"    Content="Cutie automata"   Margin="0,0,18,4"
                                                      Checked="Optiuni_Schimbat" Unchecked="Optiuni_Schimbat"/>
                                            <CheckBox x:Name="cbSenzori" Content="Senzori parcare"  Margin="0,0,18,4"
                                                      Checked="Optiuni_Schimbat" Unchecked="Optiuni_Schimbat"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- BUTOANE ACTIUNI -->
                                <Border Background="{StaticResource BrushBorder}" Height="1" Margin="0,20,0,16"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource BtnAccent}"
                                            Click="AdaugaMasina_Click"
                                            IsEnabled="{Binding MasinaCurenta.EsteValid}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Adauga"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnPrimary}" Click="ModificaMasina_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Modifica"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnDanger}" Click="StergeMasina_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Sterge"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Click="ReseteazaMasina_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Reseteaza formular"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- PREVIEW CARD (ticket) -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Previzualizare" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                                <TextBlock Text="Cum se vede masina curenta" Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,16"/>

                                <!-- Color chip + denumire -->
                                <Border CornerRadius="14" Padding="18" Background="{StaticResource BrushHero}"
                                        Effect="{StaticResource ShadowSoft}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Color chip (binding la culoarea masinii) -->
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                                    Background="{Binding MasinaCurenta.Culoare, Converter={StaticResource culoareToBrush}}"
                                                    BorderBrush="#1E293B" BorderThickness="2" Margin="0,0,12,0">
                                                <TextBlock Text="&#xE7C0;" FontFamily="{StaticResource FontIcons}"
                                                           FontSize="22" Foreground="#FFFFFF" Opacity="0.85"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold"
                                                           Text="{Binding MasinaCurenta.Combustibil}"/>
                                                <TextBlock Text="{Binding MasinaCurenta.DenumireCompleta}"
                                                           FontFamily="{StaticResource FontDisplay}" FontSize="18"
                                                           FontWeight="SemiBold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Pret badge -->
                                        <Border Background="#F59E0B" CornerRadius="8" Padding="10,6" Margin="0,14,0,0"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MasinaCurenta.PretPeZi, StringFormat=N2}"
                                                           FontFamily="{StaticResource FontDisplay}" FontSize="16"
                                                           FontWeight="SemiBold" Foreground="#0B1220"/>
                                                <TextBlock Text=" lei / zi" FontSize="11"
                                                           Foreground="#0B1220" VerticalAlignment="Center" Margin="3,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1E293B" Height="1" Margin="0,14"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#10B981" CornerRadius="20" Padding="9,4"
                                                    Visibility="{Binding MasinaCurenta.Disponibila, Converter={StaticResource boolToVis}}">
                                                <TextBlock Text="DISPONIBILA" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#EF4444" CornerRadius="20" Padding="9,4"
                                                    Visibility="{Binding MasinaCurenta.Disponibila, Converter={StaticResource boolToVis}, ConverterParameter=invert}">
                                                <TextBlock Text="IN REZERVARE" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Optiuni chips -->
                                <TextBlock Style="{StaticResource TextLabel}" Text="DOTARI" Margin="0,18,0,8"/>
                                <WrapPanel>
                                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding MasinaCurenta.Optiuni}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                    </Border>
                                </WrapPanel>

                                <Border Background="{StaticResource BrushBorder}" Height="1" Margin="0,18"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="ID"/>
                                        <TextBlock Text="{Binding MasinaCurenta.IdMasina}" Style="{StaticResource TextBody}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="ACTUALIZAT"/>
                                        <TextBlock Text="{Binding MasinaCurenta.DataActualizare, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Style="{StaticResource TextBody}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- DATA GRID -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Grid Margin="20,18,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Flota actuala" Style="{StaticResource TextH3}"/>
                                    <TextBlock Text="Click pe un rand pentru a edita masina" Style="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="dgMasini" BorderThickness="0,1,0,0"
                                      SelectionChanged="dgMasini_SelectionChanged" MaxHeight="380">
                                <DataGrid.Columns>
                                    <DataGridTextColumn     Header="ID"           Binding="{Binding IdMasina}"            Width="60"/>
                                    <DataGridTextColumn     Header="MARCA"        Binding="{Binding Marca}"               Width="110"/>
                                    <DataGridTextColumn     Header="MODEL"        Binding="{Binding Model}"               Width="130"/>
                                    <DataGridTextColumn     Header="PRET/ZI"      Binding="{Binding PretPeZi, StringFormat=N2}" Width="90"/>
                                    <DataGridCheckBoxColumn Header="DISPONIBILA"  Binding="{Binding Disponibila}"         Width="110"/>
                                    <DataGridTextColumn     Header="CULOARE"      Binding="{Binding Culoare}"             Width="90"/>
                                    <DataGridTextColumn     Header="COMBUSTIBIL"  Binding="{Binding Combustibil}"         Width="110"/>
                                    <DataGridTextColumn     Header="OPTIUNI"      Binding="{Binding Optiuni}"             Width="*"/>
                                    <DataGridTextColumn     Header="ACTUALIZAT"   Binding="{Binding DataActualizare, StringFormat=\{0:dd.MM HH:mm\}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ////////////  PANEL: REZERVARI  //////////// -->
            <ScrollViewer x:Name="panelRezervari" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HERO -->
                    <Border Grid.Row="0" CornerRadius="18" Padding="32,28"
                            Background="{StaticResource BrushHero}" Effect="{StaticResource ShadowMedium}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#1E293B" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bookings" Margin="6,0,0,0"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Rezervari active" Margin="0,14,0,6"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="32"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Selecteaza o masina disponibila, completeaza datele clientului si confirma."
                                           FontSize="13" Foreground="#94A3B8" MaxWidth="540" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Ilustratie calendar -->
                            <Viewbox Grid.Column="1" Width="160" Height="120" Margin="20,0,0,0">
                                <Canvas Width="140" Height="120">
                                    <Border Canvas.Left="0" Canvas.Top="14" Width="120" Height="100" CornerRadius="12"
                                            Background="#F8FAFC"/>
                                    <Border Canvas.Left="0" Canvas.Top="14" Width="120" Height="26" CornerRadius="12,12,0,0"
                                            Background="#F59E0B"/>
                                    <Rectangle Canvas.Left="22" Canvas.Top="0"  Width="6" Height="28" RadiusX="3" RadiusY="3" Fill="#FBBF24"/>
                                    <Rectangle Canvas.Left="92" Canvas.Top="0"  Width="6" Height="28" RadiusX="3" RadiusY="3" Fill="#FBBF24"/>
                                    <TextBlock Canvas.Left="44" Canvas.Top="50" Text="15" FontFamily="Segoe UI"
                                               FontSize="36" FontWeight="Bold" Foreground="#0B1220"/>
                                    <Ellipse Canvas.Left="24" Canvas.Top="92" Width="6" Height="6" Fill="#10B981"/>
                                    <Ellipse Canvas.Left="40" Canvas.Top="92" Width="6" Height="6" Fill="#10B981"/>
                                    <Ellipse Canvas.Left="56" Canvas.Top="92" Width="6" Height="6" Fill="#CBD5E1"/>
                                    <Ellipse Canvas.Left="72" Canvas.Top="92" Width="6" Height="6" Fill="#CBD5E1"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- FORM (2 columns: lista masini + detalii rezervare) -->
                    <Grid Grid.Row="1" Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lista masini disponibile -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Masini disponibile" Style="{StaticResource TextH3}"/>
                                        <TextBlock Text="Alege masina pentru rezervare" Style="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushSuccessSoft}"
                                            CornerRadius="20" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold"
                                                   Text="{Binding ElementName=lstMasiniDisponibile, Path=Items.Count, StringFormat='{}{0} libere'}"/>
                                    </Border>
                                </Grid>

                                <ListBox x:Name="lstMasiniDisponibile"
                                         Height="260" BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="lstMasiniDisponibile_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                        Margin="0,0,12,0"
                                                        Background="{Binding Culoare, Converter={StaticResource culoareToBrush}}"
                                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                    <TextBlock Text="&#xE7C0;" FontFamily="{StaticResource FontIcons}"
                                                               FontSize="18" Foreground="White" Opacity="0.85"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DenumireCompleta}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Combustibil}" FontSize="11"
                                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                                        <Ellipse Width="3" Height="3" Margin="6,1,6,0"
                                                                 Fill="{StaticResource BrushBorderStrong}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Culoare}" FontSize="11"
                                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{StaticResource BrushAccentSoft}"
                                                        CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PretPeZi, StringFormat=N0}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushAccentHover}"/>
                                                        <TextBlock Text=" lei" FontSize="11"
                                                                   Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="8"
                                        Padding="10" Margin="0,12,0,0">
                                    <TextBlock x:Name="tbInfoMasinaAleasa" FontSize="12"
                                               Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Detalii rezervare -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Detalii rezervare" Style="{StaticResource TextH3}" Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource TextLabel}" Text="NUME CLIENT"/>
                                    <TextBox x:Name="txtNumeClient" MaxLength="50"
                                             Text="{Binding RezervareCurenta.NumeClient, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged,
                                                            ValidatesOnDataErrors=True}"/>
                                    <TextBlock Foreground="{StaticResource BrushDanger}" FontSize="11" Margin="2,4,0,0"
                                               Text="{Binding ElementName=txtNumeClient, Path=(Validation.Errors)/ErrorContent}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource TextLabel}" Text="TELEFON (10 CIFRE)"/>
                                    <TextBox x:Name="txtTelefon" MaxLength="10"
                                             Text="{Binding RezervareCurenta.NumarTelefon, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged,
                                                            ValidatesOnDataErrors=True}"/>
                                    <TextBlock Foreground="{StaticResource BrushDanger}" FontSize="11" Margin="2,4,0,0"
                                               Text="{Binding ElementName=txtTelefon, Path=(Validation.Errors)/ErrorContent}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="DATA START"/>
                                        <DatePicker x:Name="dtpDataStart"
                                                    SelectedDateChanged="DataRezervare_Schimbata"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="DATA SFARSIT"/>
                                        <DatePicker x:Name="dtpDataSfarsit"
                                                    SelectedDateChanged="DataRezervare_Schimbata"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource BrushHero}" CornerRadius="12"
                                        Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="COST TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="tbCostTotal" Foreground="White"
                                                       FontFamily="{StaticResource FontDisplay}" FontSize="20"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" Text="0,00 lei"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F59E0B" CornerRadius="10"
                                                Width="44" Height="44" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE825;" FontFamily="{StaticResource FontIcons}" FontSize="22"
                                                       Foreground="#0B1220" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource BrushBorder}" Height="1" Margin="0,16"/>

                                <WrapPanel>
                                    <Button Style="{StaticResource BtnAccent}"
                                            Click="AdaugaRezervare_Click"
                                            IsEnabled="{Binding RezervareCurenta.EsteValid}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Confirma rezervare"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnPrimary}" Click="ModificaRezervare_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Modifica"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnDanger}" Click="StergeRezervare_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Anuleaza"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Click="ReseteazaRezervare_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Reseteaza"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Lista rezervari -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Grid Margin="20,18,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Rezervari inregistrate" Style="{StaticResource TextH3}"/>
                                    <TextBlock Text="Selecteaza o rezervare pentru a o modifica sau anula" Style="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="dgRezervari" BorderThickness="0,1,0,0"
                                      SelectionChanged="dgRezervari_SelectionChanged" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"            Binding="{Binding IdRezervare}"  Width="60"/>
                                    <DataGridTextColumn Header="ID MASINA"     Binding="{Binding IdMasina}"     Width="90"/>
                                    <DataGridTextColumn Header="CLIENT"        Binding="{Binding NumeClient}"   Width="170"/>
                                    <DataGridTextColumn Header="TELEFON"       Binding="{Binding NumarTelefon}" Width="120"/>
                                    <DataGridTextColumn Header="PERIOADA"      Binding="{Binding Perioada}"     Width="*"/>
                                    <DataGridTextColumn Header="PRET/ZI"       Binding="{Binding PretPeZi, StringFormat=N2}"   Width="90"/>
                                    <DataGridTextColumn Header="COST TOTAL"    Binding="{Binding CostTotal, StringFormat=N2}"  Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ////////////  PANEL: CAUTARE  //////////// -->
            <Grid x:Name="panelCautare" Visibility="Collapsed" Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HERO + SEARCH -->
                <Border Grid.Row="0" CornerRadius="18" Padding="32,28"
                        Background="{StaticResource BrushHero}" Effect="{StaticResource ShadowMedium}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushInfo}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Filtru live" Margin="6,0,0,0"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Cauta masina" Margin="0,14,0,6"
                                       FontFamily="{StaticResource FontDisplay}" FontSize="32"
                                       FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Filtrare in timp real dupa marca sau model."
                                       FontSize="13" Foreground="#94A3B8" MaxWidth="540" TextWrapping="Wrap"/>

                            <!-- Search bar -->
                            <Border Background="White" CornerRadius="10" Padding="6"
                                    Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                    Effect="{StaticResource ShadowSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource FontIcons}"
                                               FontSize="18" Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="12,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="txtCautare"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="14" MinHeight="38"
                                             TextChanged="txtCautare_TextChanged"/>
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Click="ReseteazaCautare_Click"
                                            Padding="10,6" MinWidth="0" Margin="6,0,4,0">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FontIcons}" FontSize="13"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Ilustratie lupa -->
                        <Viewbox Grid.Column="1" Width="140" Height="140" Margin="20,0,0,0">
                            <Canvas Width="120" Height="120">
                                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="80" Height="80"
                                         Stroke="#F8FAFC" StrokeThickness="10" Fill="#1E293B"/>
                                <Ellipse Canvas.Left="22" Canvas.Top="22" Width="56" Height="56"
                                         Fill="#F59E0B" Opacity="0.4"/>
                                <Rectangle Canvas.Left="78" Canvas.Top="78" Width="40" Height="12"
                                           RadiusX="6" RadiusY="6" Fill="#F8FAFC"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Info -->
                <Border Grid.Row="1" Margin="0,18,0,12">
                    <TextBlock x:Name="tbInfoCautare" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold"/>
                </Border>

                <!-- Rezultate -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="dgCautare" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn     Header="ID"          Binding="{Binding IdMasina}"     Width="60"/>
                            <DataGridTextColumn     Header="MARCA"       Binding="{Binding Marca}"        Width="140"/>
                            <DataGridTextColumn     Header="MODEL"       Binding="{Binding Model}"        Width="170"/>
                            <DataGridTextColumn     Header="PRET/ZI"     Binding="{Binding PretPeZi, StringFormat=N2}" Width="100"/>
                            <DataGridCheckBoxColumn Header="DISPONIBILA" Binding="{Binding Disponibila}"  Width="110"/>
                            <DataGridTextColumn     Header="COMBUSTIBIL" Binding="{Binding Combustibil}"  Width="110"/>
                            <DataGridTextColumn     Header="OPTIUNI"     Binding="{Binding Optiuni}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
